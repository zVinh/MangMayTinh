      const s=new THREE.Mesh(new THREE.SphereGeometry(isWan?.03:.02,8,8),new THREE.MeshBasicMaterial({color:col}));
      grp.add(s);
      pk.push({c,s,t:i/np,v:.0018+Math.random()*.001,isWan});
