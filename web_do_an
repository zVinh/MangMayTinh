Lab2 - Web giới thiệu đồ án
https://net7-campus.page.gd/
<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Net7 × iSMART — Thiết kế &amp; triển khai mô hình mạng an toàn cho doanh nghiệp giáo dục tại Việt Nam</title>
<meta name="description" content="Đồ án Mạng máy tính Nhóm 07 (Khoa CNTTKD – UEH): Thiết kế &amp; triển khai mô hình mạng an toàn cho doanh nghiệp giáo dục tại Việt Nam — iSMART Education (VLSM, OSPF Multi-Area, GRE-over-IPSec, Kids Mode &amp; Local Cache).">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#070b12;
  --ink:#e9f1f4;
  --mut:#8da3ae;
  --acc:#d4f175;
  --t:#5eead4;
  --v:#a78bfa;
  --org:#fb923c;
  --err:#f87171;
  --card:rgba(14,22,34,.58);
  --card-hi:rgba(20,32,48,.76);
  --line:rgba(255,255,255,.11);
  --line-hi:rgba(212,241,117,.45);
  color-scheme:dark;
}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth}
body{
  font:400 15.5px/1.65 'Be Vietnam Pro',system-ui,-apple-system,sans-serif;
  background:var(--bg);
  color:var(--ink);
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
}
.scroll-bar{
  position:fixed;top:0;left:0;height:2.5px;width:0;z-index:30;
  background:linear-gradient(90deg,var(--t),var(--acc));
  pointer-events:none;transition:width .08s linear;
}
#gl{position:fixed;inset:0;width:100%;height:100%;z-index:0;transition:opacity .25s ease}
#tags{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden}
.tag{
  position:absolute;left:0;top:0;
  display:inline-flex;align-items:center;gap:6px;
  font:600 11.5px/1 'JetBrains Mono',ui-monospace,monospace;
  padding:5px 10px;border-radius:99px;
  background:rgba(7,11,18,.78);
  border:1px solid var(--line);
  backdrop-filter:blur(8px);
  color:#eaf6f8;white-space:nowrap;
  transition:opacity .25s ease;
}
.tag i{width:6px;height:6px;border-radius:50%;display:inline-block}
.tag.island{font-size:10.5px;padding:4px 8px;border-color:rgba(94,234,212,.34);color:#bff3eb}
.tag.active{border-color:var(--acc);color:#fff;background:rgba(12,24,36,.92);box-shadow:0 4px 16px rgba(212,241,117,.22)}

/* Top Navigation */
nav{
  position:sticky;top:0;z-index:20;
  display:flex;justify-content:space-between;align-items:center;gap:14px;
  padding:12px max(18px,5vw);
  background:rgba(7,11,18,.68);
  backdrop-filter:blur(16px);
  border-bottom:1px solid var(--line);
}
.brand{
  display:inline-flex;align-items:center;gap:9px;
  font-weight:800;letter-spacing:.06em;text-decoration:none;color:var(--ink);white-space:nowrap;
}
.brand-dot{
  width:10px;height:10px;border-radius:50%;
  background:linear-gradient(135deg,var(--t),var(--acc));
  box-shadow:0 0 10px rgba(94,234,212,.7);
}
.brand i{color:var(--acc);font-style:normal}
.nav-links{display:flex;align-items:center;flex-wrap:wrap;gap:6px 18px}
.nav-links a{
  color:var(--mut);text-decoration:none;font-size:13.5px;font-weight:600;
  transition:color .2s;white-space:nowrap;position:relative;padding:4px 0;
}
.nav-links a:hover,.nav-links a:focus-visible,.nav-links a.active{color:var(--acc)}
.nav-links a.active:after{
  content:"";position:absolute;left:0;right:0;bottom:-2px;height:2px;
  background:var(--acc);border-radius:2px;
}
.nav-cta{
  padding:6px 14px!important;border-radius:99px;
  background:rgba(212,241,117,.12);border:1px solid rgba(212,241,117,.38);
  color:var(--acc)!important;
}
.nav-cta:hover{background:var(--acc);color:#0f1d09!important}
.nav-cta.active:after{display:none}

main{position:relative;z-index:1}
section{max-width:1200px;margin:auto;padding:74px max(18px,5vw);scroll-margin-top:64px}

/* Minimal, Modern Hero (like index (1).html) */
.hero{
  min-height:calc(100vh - 54px);
  display:flex;flex-direction:column;justify-content:center;gap:20px;
  padding-top:36px;padding-bottom:48px;position:relative;
}
.hero:before{
  content:"";position:absolute;inset:0 auto 0 -60px;width:min(640px,100%);
  background:radial-gradient(ellipse at 32% 50%,rgba(7,11,18,.78) 0%,rgba(7,11,18,.42) 56%,transparent 84%);
  pointer-events:none;z-index:-1;
}
.hero>*{max-width:575px}
.eyebrow{
  display:inline-flex;align-items:center;gap:8px;width:fit-content;
  font:700 11px/1 'JetBrains Mono',ui-monospace,monospace;
  letter-spacing:.12em;text-transform:uppercase;color:var(--acc);
  padding:6px 12px;border-radius:99px;
  background:rgba(212,241,117,.08);border:1px solid rgba(212,241,117,.24);
}
.eyebrow:before{content:"";width:6px;height:6px;border-radius:50%;background:var(--t);box-shadow:0 0 8px var(--t)}
h1{
  font-size:clamp(28px,3.6vw,44px);line-height:1.14;font-weight:800;letter-spacing:-.025em;
  background:linear-gradient(125deg,#fff 14%,var(--t) 60%,var(--acc) 100%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
h2{font-size:clamp(24px,3.2vw,36px);font-weight:800;line-height:1.2;letter-spacing:-.02em;margin:8px 0 10px}
h3{font-size:17px;font-weight:700;line-height:1.35}
.lead{color:var(--mut);max-width:740px}

.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{
  font:600 13px/1.1 inherit;color:var(--ink);
  background:rgba(14,22,34,.72);border:1px solid var(--line);
  border-radius:99px;padding:8px 14px;cursor:pointer;transition:.18s;
  backdrop-filter:blur(10px);min-height:36px;
}
.chip:hover,.chip[aria-pressed=true]{background:var(--acc);color:#10200a;border-color:var(--acc)}
.chip.warn[aria-pressed=true]{background:var(--org);color:#1a0a02;border-color:var(--org)}

#info{
  min-height:48px;font-size:13.5px;color:#cde4ea;line-height:1.55;
  padding:11px 14px;border-radius:13px;
  background:rgba(10,17,29,.76);border:1px solid var(--line);
  border-left:3px solid var(--t);backdrop-filter:blur(12px);
}
.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:2px}
.stats div{
  padding:12px 13px;border-radius:14px;
  background:rgba(13,22,36,.72);border:1px solid var(--line);backdrop-filter:blur(12px);
}
.stats b{display:block;font:800 22px/1.15 'JetBrains Mono',monospace;color:var(--acc)}
.stats span{display:block;font-size:11.5px;color:var(--mut);margin-top:3px;line-height:1.35}

/* Grids & Glass Cards */
.grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));margin-top:24px}
.grid-3{display:grid;gap:16px;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:24px}
.grid-4{display:grid;gap:14px;grid-template-columns:repeat(4,minmax(0,1fr));margin-top:16px}
.card{
  background:var(--card);border:1px solid var(--line);
  border-radius:18px;padding:22px;backdrop-filter:blur(12px);
  transition:transform .2s,border-color .2s,background .2s,opacity .6s;
}
.card:hover{border-color:var(--line-hi);background:var(--card-hi)}
.card h3{margin-bottom:6px}
.card p{color:var(--mut);font-size:13.8px}
.card small{display:block;color:var(--acc);font-size:11.5px;margin:2px 0 8px;font-family:'JetBrains Mono',monospace}
.pill{
  display:inline-block;font:700 11px/1 'JetBrains Mono',monospace;
  padding:4px 10px;border-radius:99px;border:1px solid var(--line);
  margin:0 6px 10px 0;letter-spacing:.03em;
}
.compact-list{list-style:none;padding:0;margin-top:10px;display:grid;gap:6px}
.compact-list li{font-size:13.2px;color:#c9dde4;padding-left:14px;position:relative}
.compact-list li:before{content:"›";position:absolute;left:0;color:var(--t);font-weight:800}
.compact-list li b{color:var(--ink)}

.proto-strip{display:flex;flex-wrap:wrap;gap:7px;margin-top:18px}
.proto-strip span{
  font:600 11.5px 'JetBrains Mono',monospace;
  padding:5px 11px;border-radius:99px;
  background:rgba(94,234,212,.07);border:1px solid rgba(94,234,212,.22);
  color:#b6f4ea;
}

/* Panels & Tables */
.panel{
  background:var(--card);border:1px solid var(--line);
  border-radius:20px;padding:22px;backdrop-filter:blur(14px);margin-top:20px;
}
.grid .panel{margin-top:0}
.panel h3{margin-bottom:10px;font-size:16.5px}
.big{font:800 26px/1.15 'JetBrains Mono',monospace;color:var(--acc);margin:10px 0 4px}
.tabs{display:flex;flex-wrap:wrap;gap:8px;margin:20px 0 12px}
.bar{
  display:flex;height:32px;border-radius:10px;overflow:hidden;border:1px solid var(--line);
  background:repeating-linear-gradient(45deg,#ffffff0d 0 6px,transparent 6px 12px);
}
.bar i{display:block;height:100%;border-right:2px solid var(--bg);transition:filter .2s;cursor:pointer}
.bar i:hover{filter:brightness(1.25)}
.tw{overflow-x:auto;margin-top:12px;border:1px solid var(--line);border-radius:15px;background:var(--card);backdrop-filter:blur(12px)}
table{border-collapse:collapse;width:100%;min-width:640px;font-size:13.5px}
th,td{padding:10px 14px;text-align:left;border-bottom:1px solid var(--line)}
th{font:700 11px 'JetBrains Mono',monospace;color:var(--mut);text-transform:uppercase;letter-spacing:.08em}
tr:last-child td{border:0}
tbody tr{transition:background .15s}
tbody tr:hover{background:rgba(212,241,117,.06)}
code{font:12.5px 'JetBrains Mono',ui-monospace,monospace;color:var(--t)}
code.copyable{cursor:pointer;border-bottom:1px dashed rgba(94,234,212,.45);padding:1px 3px;border-radius:4px}
code.copyable:hover{background:rgba(94,234,212,.14);color:#fff}
.dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:8px}
#used{font-size:13px;color:var(--mut);margin-top:8px}

/* Topology SVG */
#topo-svg{width:100%;height:auto;display:block}
.sbox{cursor:pointer}.sbox rect{transition:filter .2s,stroke-width .2s}
.sbox:hover rect,.sbox:focus-visible rect{filter:brightness(1.14);stroke-width:3}
#topo-svg text{font-family:inherit}

/* Wi-Fi Roaming */
.corr{
  position:relative;height:62px;border:1px solid var(--line);border-radius:14px;margin-bottom:14px;
  background:linear-gradient(90deg,#5eead420,#a78bfa20,#d4f17520);
}
.corr i{
  position:absolute;top:0;width:33.3%;height:100%;border-right:2px dashed var(--line);
  font:600 12px/62px inherit;text-align:center;font-style:normal;color:var(--mut);
}
.corr i:last-of-type{border-right:0}
.corr b{
  position:absolute;top:17px;width:28px;height:28px;border-radius:50%;
  background:var(--acc);box-shadow:0 0 16px rgba(212,241,117,.65);
  transform:translateX(-50%);transition:left .08s;
}
input[type=range]{width:100%;accent-color:#d4f175;cursor:pointer}
.sw{display:inline-flex;align-items:center;gap:8px;margin:12px 0;color:#cbe0e8;font-size:14px;cursor:pointer}
.wr{display:grid;gap:9px}
.ap{display:grid;grid-template-columns:165px 1fr 74px;gap:10px;align-items:center;font-size:13px}
.ap-track{position:relative;height:10px;border-radius:9px;background:#ffffff14;overflow:hidden}
.ap-track i{display:block;height:100%;background:var(--t);transition:width .1s}
.ap-track:after{
  content:"";position:absolute;top:0;bottom:0;left:46%;width:2px;
  background:rgba(251,146,60,.8);pointer-events:none;
}
.ap.on{color:var(--acc);font-weight:600}.ap.on .ap-track i{background:var(--acc)}

/* ACL Simulator */
.two{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:14px 0}
select,input[type=number],input:not([type]){
  width:100%;font:inherit;font-size:14px;color:var(--ink);
  background:#0c1420;border:1px solid var(--line);border-radius:12px;padding:10px 12px;
}
.route{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:6px 0;font-size:13px}
.route span{background:#ffffff12;border-radius:10px;padding:6px 12px}
.route b{color:var(--acc);font-family:'JetBrains Mono',monospace}
.out{
  white-space:pre-wrap;font:13px/1.6 'JetBrains Mono',ui-monospace,monospace;
  background:#05090f;border:1px solid var(--line);border-left:4px solid var(--acc);
  border-radius:12px;padding:13px 14px;margin:12px 0;min-height:58px;color:#d6f5ee;
}
.out.den{border-left-color:var(--err);color:#fecaca}
#mt{margin-top:14px}#mt table{min-width:0;font-size:12px}#mt td{cursor:pointer;text-align:center;padding:8px;font-family:'JetBrains Mono',monospace}
.ok{background:#d4f17526;color:#e3f8a0}.no{background:#f8717130;color:#fecaca}

/* Kids Mode 2-Column Single-App Kiosk + 50 Tablet Grid */
.kc{display:flex;flex-wrap:wrap;gap:9px;align-items:center}
.kc label{color:var(--mut);font-size:13px;display:inline-flex;align-items:center;gap:6px}
.kc input{width:130px}
.kids-layout{display:grid;grid-template-columns:270px 1fr;gap:20px;align-items:start;margin-top:16px}
.tablet-frame{
  background:#070d16;border:2px solid rgba(148,185,204,.26);border-radius:22px;
  padding:11px;box-shadow:0 16px 36px rgba(0,0,0,.42);display:flex;flex-direction:column;gap:9px;
}
.tablet-topbar{display:flex;justify-content:space-between;align-items:center;font:600 10.5px/1 'JetBrains Mono',monospace;color:var(--mut);padding:2px 4px}
.tablet-topbar b{color:var(--t)}
.tablet-screen{
  position:relative;min-height:244px;border-radius:15px;padding:16px 14px;
  background:radial-gradient(circle at 50% 28%,rgba(22,68,86,.42),rgba(7,15,26,.96));
  border:1px solid rgba(94,234,212,.22);
  display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:11px;overflow:hidden;
}
.kiosk-pill{
  position:absolute;top:10px;left:10px;right:10px;
  font:700 9.5px/1.2 'JetBrains Mono',monospace;color:var(--acc);
  background:rgba(212,241,117,.1);border:1px solid rgba(212,241,117,.26);
  padding:5px 8px;border-radius:99px;
}
.app-only-btn{
  margin-top:18px;width:82px;height:82px;border-radius:18px;cursor:pointer;
  background:linear-gradient(145deg,#0f6b78,#0a3d4d);border:1.5px solid var(--t);color:#fff;
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;
  box-shadow:0 10px 22px rgba(15,107,120,.32);transition:transform .18s;
}
.app-only-btn:hover{transform:translateY(-2px)}
.app-only-btn span{font-size:25px;line-height:1}
.app-only-btn strong{font:800 11.5px/1 'JetBrains Mono',monospace;color:var(--acc)}
.kiosk-empty-note{font-size:11.5px;color:var(--mut);line-height:1.45;max-width:205px}
.exit-kiosk-btn{
  width:100%;font:600 11.5px 'JetBrains Mono',monospace;color:var(--mut);
  background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:10px;
  padding:7px 10px;cursor:pointer;transition:.18s;
}
.exit-kiosk-btn:hover{border-color:var(--org);color:#fed7aa}
.tablet-overlay{
  position:absolute;inset:0;padding:16px;background:rgba(5,10,18,.94);backdrop-filter:blur(4px);
  display:none;flex-direction:column;align-items:center;justify-content:center;gap:8px;text-align:center;
}
.tablet-overlay.show{display:flex}
.tablet-overlay.pin{background:rgba(18,10,14,.95);border:1.5px solid var(--err)}
.tablet-overlay strong{font-size:12.5px;color:var(--acc)}
.tablet-overlay.pin strong{color:#fca5a5}
.tablet-overlay small{font-size:11.5px;color:var(--mut);line-height:1.42}
.kt{display:grid;grid-template-columns:repeat(10,1fr);gap:6px;margin:0 0 12px}
.kt i{
  aspect-ratio:3/4;display:grid;place-items:center;font:600 11px inherit;font-style:normal;
  border-radius:8px;background:#5eead422;border:1px solid rgba(94,234,212,.65);transition:.22s;cursor:pointer;
}
.kt i:hover{border-color:#fff}
.kt i.sel{box-shadow:0 0 0 2px #fff}
.kt i.lock{background:#f8717126;border-color:var(--err);color:#fecaca}
.kt i.bad{animation:fl .55s 2;background:var(--err);color:#fff}
@keyframes fl{50%{transform:scale(1.16)}}

/* Wireshark */
.ws-bar{
  display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;
  padding:8px 12px;border-radius:10px;background:#05090f;border:1px solid var(--line);
  font:600 12px 'JetBrains Mono',monospace;color:var(--t);margin-bottom:10px;
}
.ws-bar span{color:var(--mut);font-weight:500}
#wsp{word-break:break-all}

/* Cost Controls */
.f{display:block;color:var(--mut);font-size:13px;margin:10px 0}.f output{float:right;color:var(--ink);font-family:'JetBrains Mono',monospace}.f input{margin-top:6px}

/* Compact 5-Stage Horizontal Roadmap (Tiến độ) */
.roadmap{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;margin-top:22px}
.step{
  padding:16px 15px;border-radius:16px;background:var(--card);border:1px solid var(--line);
  backdrop-filter:blur(12px);display:flex;flex-direction:column;justify-content:space-between;gap:8px;
}
.step-top{display:flex;justify-content:space-between;align-items:center;font:700 11px 'JetBrains Mono',monospace}
.step-top b{color:var(--t)}.step-top span{color:var(--acc)}
.step h3{font-size:14px;line-height:1.35}
.step p{font-size:12.5px;color:var(--mut);line-height:1.5}

/* Team Avatar */
.av{
  display:grid;place-items:center;width:44px;height:44px;border-radius:13px;
  background:linear-gradient(135deg,var(--t),var(--v));color:#07131c;font-weight:800;margin-bottom:10px;
}

/* Contact Section (matching 2-column academic card layout) */
.contact-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:20px;margin-top:24px;align-items:stretch}
.contact-stack{display:grid;gap:12px}
.contact-item{
  display:flex;gap:14px;align-items:flex-start;
  padding:16px 18px;border-radius:16px;
  background:rgba(6,12,22,.66);border:1px solid var(--line);
  transition:border-color .2s;
}
.contact-item:hover{border-color:rgba(94,234,212,.32)}
.contact-ico{
  width:40px;height:40px;border-radius:11px;flex:none;display:grid;place-items:center;
  background:rgba(94,234,212,.12);border:1px solid rgba(94,234,212,.3);
  color:var(--t);font-weight:800;font-size:16px;
}
.contact-item b{display:block;font-size:14.5px;margin-bottom:3px;color:var(--ink)}
.contact-item p{font-size:13.5px;color:var(--mut);line-height:1.58}
.contact-right{display:flex;flex-direction:column;justify-content:space-between;gap:16px}
.contact-actions{display:flex;flex-direction:column;align-items:flex-start;gap:10px;margin-top:18px}
.btn-cta{
  display:inline-flex;align-items:center;gap:8px;text-decoration:none;
  font:700 13.5px inherit;padding:11px 20px;border-radius:99px;cursor:pointer;border:0;transition:.18s;
}
.btn-cta.pri{background:var(--acc);color:#0f1d09}
.btn-cta.pri:hover{filter:brightness(1.06);transform:translateY(-1px)}
.btn-cta.sec{background:rgba(255,255,255,.06);color:var(--ink);border:1px solid var(--line)}
.btn-cta.sec:hover{border-color:var(--t);color:var(--t)}
.copy-inline{font:600 12px 'JetBrains Mono',monospace;color:var(--acc);min-height:18px;margin-top:8px}
.contact-note{font-size:12px;color:var(--mut);border-top:1px solid var(--line);padding-top:14px;line-height:1.6}

footer{
  position:relative;z-index:1;text-align:center;
  border-top:1px solid var(--line);
  background:rgba(5,9,16,.8);backdrop-filter:blur(12px);
  padding:26px max(18px,5vw) 36px;font-size:13px;color:var(--mut);
}

.toast{
  position:fixed;right:20px;bottom:20px;z-index:40;
  padding:10px 15px;border-radius:11px;background:rgba(7,14,24,.94);
  border:1px solid var(--acc);color:var(--ink);
  font:600 12.5px 'JetBrains Mono',monospace;
  box-shadow:0 12px 30px rgba(0,0,0,.45);
  opacity:0;transform:translateY(10px);pointer-events:none;transition:.2s ease;
}
.toast.show{opacity:1;transform:none}

.reveal{opacity:0;transform:translateY(20px)}
.reveal.in{opacity:1;transform:none;transition:opacity .6s,transform .6s}
:focus-visible{outline:2px solid var(--acc);outline-offset:3px}

@media(max-width:1024px){
  .roadmap{grid-template-columns:repeat(2,minmax(0,1fr))}
