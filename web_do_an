    });
    if(!reduce){
      orbitRings.forEach(o=>o.rg.rotation.z+=o.spd);
      starField.rotation.y=t*.01;
      pk.forEach(o=>{if(!o.s.visible)return;o.t=(o.t+o.v)%1;o.s.position.copy(o.c.getPoint(o.t))});
    }

    grp.updateMatrixWorld();
    allTagged.forEach(item=>{
      item.m.getWorldPosition(tmp);
      tmp2.copy(tmp).sub(grp.position).normalize();
      const f=tmp2.dot(cam.position.clone().sub(tmp).normalize())>.12;
      const q=tmp.clone().project(cam);
      const px=(q.x*.5+.5)*innerWidth;
      const py=(-q.y*.5+.5)*innerHeight;
      item.t.style.opacity=f?heroFade:0;
      if(item.side==='left'){
        item.t.style.transform=`translate(${px-12}px,${py}px) translate(-100%,-50%)`;
      }else{
        item.t.style.transform=`translate(${px+10}px,${py}px) translate(0,-50%)`;
      }
    });

    rd.render(sc,cam);
    requestAnimationFrame(tick);
  }
  tick();
})();
</script>
</body>
</html>
